<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cryptidium.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <StackPanel Padding="24" Spacing="16">
        <TextBlock x:Name="VersionText" Style="{StaticResource SubtitleTextBlockStyle}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Clear cookies" Click="OnClearCookies" />
            <Button Content="Clear cache" Click="OnClearCache" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Download location" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse..." Click="OnBrowse" />
            </Grid>
        </StackPanel>

        <CheckBox x:Name="AskCheck"
                  Content="Ask where to save each file before downloading"
                  Click="OnAskToggled" />

        <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" Severity="Success" />
    </StackPanel>
</Window>
